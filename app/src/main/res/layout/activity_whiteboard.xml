<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.whiteboard.WhiteboardActivity">

    <!-- Fullscreen Whiteboard View -->
    <com.example.moodle.ui.whiteboard.views.WhiteboardView
        android:id="@+id/whiteboardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF" />

    <!-- Main Content Area (for split mode) -->
    <LinearLayout
        android:id="@+id/mainContentArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Compact Top Bar (Glassy) -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@drawable/glassy_toolbar_background"
        android:elevation="12dp"
        android:gravity="center"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Record Button -->
        <LinearLayout
            android:id="@+id/recordContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:background="@drawable/floating_button_ripple"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <Button
                android:id="@+id/toggleRecordBtn"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/circle_button"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="@string/desc_record_button" />

        </LinearLayout>

        <!-- Split Mode Controls -->
        <LinearLayout
            android:id="@+id/splitControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp">

        <ImageButton
            android:id="@+id/btnEnableSplit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_split_enable"
            android:background="@drawable/floating_button_ripple"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/enable_split" />

        <ImageButton
            android:id="@+id/btnDisableSplit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_split_disable"
            android:background="@drawable/floating_button_ripple"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/disable_split" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="8dp"
            android:background="#33000000" />

        <!-- Import/Export Controls -->
        <ImageButton
            android:id="@+id/btnExport"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_export"
            android:background="@drawable/floating_button_ripple"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/desc_export_button" />

        <ImageButton
            android:id="@+id/btnImport"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_import"
            android:background="@drawable/floating_button_ripple"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/desc_import_button" />

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:background="#33000000" />

        <!-- Attendance Button -->
        <ImageButton
            android:id="@+id/btnAttendance"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_attendance"
            android:background="@drawable/floating_button_ripple"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/attendance_title" />

        <!-- Logout Button -->
        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_logout"
            android:background="@drawable/floating_button_ripple"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/logout" />

    </LinearLayout>

    <!-- Animated Section Dropdown (Compose) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/sectionDropdownCompose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Toggle Button -->
    <ImageButton
        android:id="@+id/btnToggleToolbars"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_chevron_up"
        android:background="@drawable/floating_button_ripple"
        android:elevation="12dp"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:layout_margin="16dp"
        android:contentDescription="@string/desc_toggle_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/zoomIndicator"
        android:text=""
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/zoom_indicator_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.7"
    />

    <!-- Floating Main Toolbar (Bottom Center - Glassy) -->
    <HorizontalScrollView
        android:id="@+id/bottomToolbarScrollView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/bottomToolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/glassy_toolbar_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center">

            <!-- Drawing Tools Group -->
            <ImageButton
                android:id="@+id/btnPen"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_pen"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_pen_tool" />

            <ImageButton
                android:id="@+id/btnEraser"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_eraser"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_eraser_tool" />

            <ImageButton
                android:id="@+id/btnTextRecognition"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_text_recognition_tool"
                android:src="@android:drawable/ic_menu_search" />

            <ImageButton
                android:id="@+id/btnText"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_text"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_text_tool" />

            <ImageButton
                android:id="@+id/btnFormula"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_formula"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_formula_tool" />

            <ImageButton
                android:id="@+id/btnShapes"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_shapes"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_shapes_tool" />

            <!-- Elegant Separator -->
            <View
                android:layout_width="2dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/separator_gradient" />

            <!-- Action Tools Group -->
            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_undo"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_undo_button" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_redo"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_redo_button" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_clear"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_clear_button" />

            <!-- Elegant Separator -->
            <View
                android:layout_width="2dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/separator_gradient" />

            <!-- View Mode Tools Group -->
            <ImageButton
                android:id="@+id/btnSelect"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_hand"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_select_tool" />

            <ImageButton
                android:id="@+id/btnPinchMode"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_move_4d"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_pinch_mode" />

            <!-- Elegant Separator -->
            <View
                android:layout_width="2dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/separator_gradient" />

            <!-- Style Tools Group -->
            <ImageButton
                android:id="@+id/btnBackground"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_background"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_background_button" />

            <!-- Elegant Separator -->
            <View
                android:layout_width="2dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/separator_gradient" />

            <!-- Pagination Controls Group -->
            <ImageButton
                android:id="@+id/btnPreviousPage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_previous_page" />

            <TextView
                android:id="@+id/tvPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="1/1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#4338CA"
                android:minWidth="32dp"
                android:gravity="center"
                android:layout_gravity="center_vertical" />

            <ImageButton
                android:id="@+id/btnNextPage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_arrow_forward"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_next_page" />

            <ImageButton
                android:id="@+id/btnDeletePage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_delete"
                android:background="@drawable/modern_tool_button_ripple"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_delete_page" />

        </LinearLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
