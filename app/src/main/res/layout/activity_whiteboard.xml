<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.whiteboard.WhiteboardActivity">

    <!-- Top Toolbar with attendance, logout, and record buttons -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Record Button -->
        <LinearLayout
            android:id="@+id/recordContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <Button
                android:id="@+id/toggleRecordBtn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_button"
                android:elevation="2dp"
                android:contentDescription="@string/desc_record_button" />

        </LinearLayout>

        <!-- Attendance Button -->
        <ImageButton
            android:id="@+id/btnAttendance"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_attendance"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/attendance_title" />

        <!-- Logout Button -->
        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_logout"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/logout" />

    </LinearLayout>

    <!-- Whiteboard View taking remaining space -->
    <com.example.moodle.ui.whiteboard.views.WhiteboardView
        android:id="@+id/whiteboardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Toolbar with drawing tools -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:padding="6dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Drawing Tools -->
        <ImageButton
            android:id="@+id/btnPen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_pen"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_pen_tool" />

        <ImageButton
            android:id="@+id/btnEraser"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_eraser"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_eraser_tool" />

        <ImageButton
            android:id="@+id/btnText"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_text"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_text_tool" />

        <ImageButton
            android:id="@+id/btnFormula"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_formula"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_formula_tool" />

        <!-- Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="4dp"
            android:background="#E0E0E0" />

        <!-- Action Tools -->
        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_undo"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_undo_button" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_redo"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_redo_button" />

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_clear"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_clear_button" />

        <!-- Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="4dp"
            android:background="#E0E0E0" />

        <!-- Mode Tools -->
        <ImageButton
            android:id="@+id/btnModeToggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_move_4d"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_mode_toggle" />

        <ImageButton
            android:id="@+id/btnPinchMode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_zoom"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_pinch_mode" />

        <!-- Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="4dp"
            android:background="#E0E0E0" />

        <!-- Color Popup Button -->
        <Button
            android:id="@+id/btnColorPicker"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="2dp"
            android:background="@drawable/color_button_background"
            android:backgroundTint="#000000"
            android:contentDescription="@string/colors" />

        <!-- Stroke Width Popup Button -->
        <ImageButton
            android:id="@+id/btnStrokeWidth"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_stroke_width"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/stroke_width" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
