<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="320dp"
    android:orientation="vertical"
    android:background="@drawable/popup_background"
    android:padding="10dp">
  
    <!-- Grid Layout for Background Patterns -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="4"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="true">

        <!-- Plain Background -->
        <FrameLayout
            android:id="@+id/backgroundPlain"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <View
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="#FFFFFF" />

        </FrameLayout>

        <!-- Grid Small -->
        <FrameLayout
            android:id="@+id/backgroundGridSmall"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <com.example.moodle.ui.whiteboard.views.BackgroundPreviewView
                android:id="@+id/previewGridSmall"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Grid Large -->
        <FrameLayout
            android:id="@+id/backgroundGridLarge"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <com.example.moodle.ui.whiteboard.views.BackgroundPreviewView
                android:id="@+id/previewGridLarge"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Lines Horizontal -->
        <FrameLayout
            android:id="@+id/backgroundLinesHorizontal"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <com.example.moodle.ui.whiteboard.views.BackgroundPreviewView
                android:id="@+id/previewLinesHorizontal"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Lines Vertical -->
        <FrameLayout
            android:id="@+id/backgroundLinesVertical"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <com.example.moodle.ui.whiteboard.views.BackgroundPreviewView
                android:id="@+id/previewLinesVertical"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Lines Both -->
        <FrameLayout
            android:id="@+id/backgroundLinesBoth"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <com.example.moodle.ui.whiteboard.views.BackgroundPreviewView
                android:id="@+id/previewLinesBoth"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Dot Grid -->
        <FrameLayout
            android:id="@+id/backgroundDotGrid"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <com.example.moodle.ui.whiteboard.views.BackgroundPreviewView
                android:id="@+id/previewDotGrid"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Graph Paper -->
        <FrameLayout
            android:id="@+id/backgroundGraphPaper"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <com.example.moodle.ui.whiteboard.views.BackgroundPreviewView
                android:id="@+id/previewGraphPaper"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center" />

        </FrameLayout>

    </GridLayout>

</LinearLayout>
