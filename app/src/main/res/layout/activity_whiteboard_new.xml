<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.whiteboard.WhiteboardActivity">

    <!-- Top Toolbar with recorder and welcome message -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Record Button -->
        <LinearLayout
            android:id="@+id/recordContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true">

            <Button
                android:id="@+id/toggleRecordBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_button"
                android:elevation="2dp"
                android:contentDescription="@string/desc_record_button" />

        </LinearLayout>

        <!-- Attendance Button -->
        <ImageButton
            android:id="@+id/btnAttendance"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_attendance"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/attendance_title" />

        <!-- Logout Button -->
        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_logout"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/logout" />

    </LinearLayout>

    <!-- Whiteboard View taking remaining space -->
    <com.example.moodle.ui.whiteboard.WhiteboardView
        android:id="@+id/whiteboardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Toolbar with drawing tools -->
    <ScrollView
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Drawing Tools Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <!-- Drawing Tools -->
                <ImageButton
                    android:id="@+id/btnPen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_pen"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_pen_tool" />

                <ImageButton
                    android:id="@+id/btnEraser"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_eraser"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_eraser_tool" />

                <!-- Separator -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="#E0E0E0" />

                <!-- Action Tools -->
                <ImageButton
                    android:id="@+id/btnUndo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_undo"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_undo_button" />

                <ImageButton
                    android:id="@+id/btnRedo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_redo"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_redo_button" />

                <ImageButton
                    android:id="@+id/btnClear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_clear"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_clear_button" />

                <!-- Separator -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="#E0E0E0" />

                <!-- Mode Tools -->
                <ImageButton
                    android:id="@+id/btnModeToggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_move_4d"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_mode_toggle" />

                <ImageButton
                    android:id="@+id/btnPinchMode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_zoom"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_pinch_mode" />

            </LinearLayout>

            <!-- Colors Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/colorBlack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#000000"
                    android:contentDescription="@string/color_black" />

                <Button
                    android:id="@+id/colorRed"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#F44336"
                    android:contentDescription="@string/color_red" />

                <Button
                    android:id="@+id/colorBlue"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#2196F3"
                    android:contentDescription="@string/color_blue" />

                <Button
                    android:id="@+id/colorGreen"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#4CAF50"
                    android:contentDescription="@string/color_green" />

                <Button
                    android:id="@+id/colorYellow"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#FFEB3B"
                    android:contentDescription="@string/color_yellow" />

                <Button
                    android:id="@+id/colorPurple"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#9C27B0"
                    android:contentDescription="@string/color_purple" />

                <Button
                    android:id="@+id/colorOrange"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#FF9800"
                    android:contentDescription="@string/color_orange" />

            </LinearLayout>

            <!-- Stroke Width Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <SeekBar
                    android:id="@+id/strokeWidthSeekBar"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:max="20"
                    android:progress="8"
                    android:contentDescription="@string/desc_stroke_width" />

                <TextView
                    android:id="@+id/strokeWidthValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp"
                    android:minWidth="20dp"
                    android:gravity="center"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</android.support.constraint.ConstraintLayout>
