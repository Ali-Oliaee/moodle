<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_background"
    android:padding="16dp"
    android:elevation="8dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ruler_tools_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <!-- Tool Selection Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- Ruler Option -->
        <LinearLayout
            android:id="@+id/rulerOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <ImageButton
                android:id="@+id/btnRulerOption"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_ruler"
                android:background="@drawable/tool_button_background"
                android:contentDescription="@string/desc_ruler_tool"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ruler"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Bag Option -->
        <LinearLayout
            android:id="@+id/bagOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <ImageButton
                android:id="@+id/btnBagOption"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_bag"
                android:background="@drawable/tool_button_background"
                android:contentDescription="@string/desc_bag_tool"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bag"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Conveyor Option -->
        <LinearLayout
            android:id="@+id/conveyorOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="4dp">

            <ImageButton
                android:id="@+id/btnConveyorOption"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_conveyor"
                android:background="@drawable/tool_button_background"
                android:contentDescription="@string/desc_conveyor_tool"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conveyor"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

