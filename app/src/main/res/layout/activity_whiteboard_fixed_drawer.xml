<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F5F5"
    tools:context=".ui.whiteboard.WhiteboardActivity">

    <!-- Fixed Navigation Drawer -->
    <ScrollView
        android:id="@+id/navigationDrawer"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Drawer Header (Compact) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/drawer_header_background"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvDrawerWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_message"
                    android:textSize="12sp"
                    android:textColor="#E0FFFFFF"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Drawer Toggle Button -->
            <LinearLayout
                android:id="@+id/drawerToggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="@drawable/drawer_item_background"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/imgDrawerToggle"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_drawer_toggle"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvDrawerToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sliding_drawer"
                    android:textSize="12sp"
                    android:textColor="#333333" />

            </LinearLayout>

            <!-- Drawing Tools Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <!-- Compact Tool Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <ImageButton
                    android:id="@+id/btnPen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_pen"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_pen_tool" />

                <ImageButton
                    android:id="@+id/btnEraser"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_eraser"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_eraser_tool" />

                <ImageButton
                    android:id="@+id/btnHighlighter"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_highlighter"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_highlighter_tool" />

            </LinearLayout>

            <!-- Actions Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/actions"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <!-- Compact Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <ImageButton
                    android:id="@+id/btnUndo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_undo"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_undo_button" />

                <ImageButton
                    android:id="@+id/btnRedo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_redo"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_redo_button" />

                <ImageButton
                    android:id="@+id/btnClear"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_clear"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_clear_button" />

            </LinearLayout>

            <!-- Mode Toggles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <ImageButton
                    android:id="@+id/btnModeToggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_pen"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_mode_toggle" />

                <ImageButton
                    android:id="@+id/btnPinchMode"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_zoom"
                    android:background="@drawable/tool_button_background"
                    android:contentDescription="@string/desc_pinch_mode" />

            </LinearLayout>

            <!-- Colors Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/colors"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <!-- Compact Color Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/colorBlack"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#000000"
                    android:contentDescription="@string/color_black" />

                <Button
                    android:id="@+id/colorRed"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#F44336"
                    android:contentDescription="@string/color_red" />

                <Button
                    android:id="@+id/colorBlue"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#2196F3"
                    android:contentDescription="@string/color_blue" />

                <Button
                    android:id="@+id/colorGreen"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#4CAF50"
                    android:contentDescription="@string/color_green" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/colorYellow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#FFEB3B"
                    android:contentDescription="@string/color_yellow" />

                <Button
                    android:id="@+id/colorPurple"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#9C27B0"
                    android:contentDescription="@string/color_purple" />

                <Button
                    android:id="@+id/colorOrange"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/color_button_background"
                    android:backgroundTint="#FF9800"
                    android:contentDescription="@string/color_orange" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="2dp" />

            </LinearLayout>

            <!-- Stroke Width Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stroke_width"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <SeekBar
                    android:id="@+id/strokeWidthSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="20"
                    android:progress="8"
                    android:contentDescription="@string/desc_stroke_width" />

                <TextView
                    android:id="@+id/strokeWidthValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Record Button -->
            <LinearLayout
                android:id="@+id/drawerRecord"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="@drawable/drawer_item_background"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/toggleRecordBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/circle_button"
                    android:elevation="2dp"
                    android:contentDescription="@string/desc_record_button" />

                <TextView
                    android:id="@+id/tvRecordStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/start_recording"
                    android:textSize="12sp"
                    android:textColor="#333333" />

            </LinearLayout>

            <!-- Attendance -->
            <LinearLayout
                android:id="@+id/drawerAttendance"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="@drawable/drawer_item_background"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_attendance"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/attendance_title"
                    android:textSize="12sp"
                    android:textColor="#333333" />

            </LinearLayout>

            <!-- Logout -->
            <LinearLayout
                android:id="@+id/drawerLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="@drawable/drawer_item_background"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_logout"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/logout"
                    android:textSize="12sp"
                    android:textColor="#D32F2F" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Main Content Layout -->
    <android.support.constraint.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- Top Toolbar with minimal controls -->
        <LinearLayout
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Welcome message -->
            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/welcome_message"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical" />

        </LinearLayout>

        <!-- Whiteboard View taking full space -->
        <com.example.moodle.ui.whiteboard.WhiteboardView
            android:id="@+id/whiteboardView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/topToolbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </android.support.constraint.ConstraintLayout>

</LinearLayout>
