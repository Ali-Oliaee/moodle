<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/section_controller_background"
    android:layout_margin="4dp">

    <!-- Section Label -->
    <TextView
        android:id="@+id/sectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Student 1"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="4dp"
        android:background="@drawable/section_label_background"
        android:clickable="true"
        android:focusable="true" />

    <!-- Drawing Tools Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <ImageButton
            android:id="@+id/btnPen"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_pen"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_pen_tool" />

        <ImageButton
            android:id="@+id/btnEraser"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_eraser"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_eraser_tool" />

        <ImageButton
            android:id="@+id/btnText"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_text"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_text_tool" />

    </LinearLayout>

    <!-- Action Tools Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_clear"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_clear_button" />

    </LinearLayout>

    <!-- Color Options (4 colors) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnColorBlack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/color_button_background"
            android:backgroundTint="#000000"
            android:contentDescription="@string/color_black" />

        <Button
            android:id="@+id/btnColorBlue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/color_button_background"
            android:backgroundTint="#2196F3"
            android:contentDescription="@string/color_blue" />

        <Button
            android:id="@+id/btnColorGreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/color_button_background"
            android:backgroundTint="#4CAF50"
            android:contentDescription="@string/color_green" />

        <Button
            android:id="@+id/btnColorRed"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/color_button_background"
            android:backgroundTint="#F44336"
            android:contentDescription="@string/color_red" />

    </LinearLayout>

</LinearLayout>
