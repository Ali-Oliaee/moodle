<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="400dp"
    android:background="@drawable/popup_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فرمول‌های ریاضی"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:textColor="#333333" />

        <!-- Quadratic Formula -->
        <LinearLayout
            android:id="@+id/formulaQuadratic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="x = (-b ± √(b²-4ac)) / 2a"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center" />

        </LinearLayout>

        <!-- Pythagorean Theorem -->
        <LinearLayout
            android:id="@+id/formulaPythagorean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="a² + b² = c²"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center" />

        </LinearLayout>

        <!-- Area of Circle -->
        <LinearLayout
            android:id="@+id/formulaCircleArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A = πr²"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center" />

        </LinearLayout>

        <!-- Distance Formula -->
        <LinearLayout
            android:id="@+id/formulaDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="d = √((x₂-x₁)² + (y₂-y₁)²)"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center" />

        </LinearLayout>

        <!-- Slope Formula -->
        <LinearLayout
            android:id="@+id/formulaSlope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="m = (y₂-y₁) / (x₂-x₁)"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center" />

        </LinearLayout>

        <!-- Volume of Sphere -->
        <LinearLayout
            android:id="@+id/formulaSphereVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="V = (4/3)πr³"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center" />

        </LinearLayout>

        <!-- Compound Interest -->
        <LinearLayout
            android:id="@+id/formulaCompoundInterest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A = P(1 + r/n)^(nt)"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center" />

        </LinearLayout>

        <!-- Law of Cosines -->
        <LinearLayout
            android:id="@+id/formulaCosines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@drawable/tool_button_background"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="c² = a² + b² - 2ab cos(C)"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
