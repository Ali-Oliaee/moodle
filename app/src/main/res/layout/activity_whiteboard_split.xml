<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.whiteboard.WhiteboardActivity">

    <!-- Top Toolbar with attendance, logout, record buttons, and split controls -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Record Button -->
        <LinearLayout
            android:id="@+id/recordContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/drawer_item_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <Button
                android:id="@+id/toggleRecordBtn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_button"
                android:elevation="2dp"
                android:contentDescription="@string/desc_record_button" />

        </LinearLayout>

        <!-- Split Mode Controls -->
        <LinearLayout
            android:id="@+id/splitControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/btnEnableSplit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_split_enable"
                android:background="@drawable/tool_button_background"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/enable_split" />

            <ImageButton
                android:id="@+id/btnDisableSplit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_split_disable"
                android:background="@drawable/tool_button_background"
                android:visibility="gone"
                android:contentDescription="@string/disable_split" />

        </LinearLayout>

        <!-- Import/Export Controls -->
        <LinearLayout
            android:id="@+id/importExportControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/btnExport"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_export"
                android:background="@drawable/tool_button_background"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/desc_export_button" />

            <ImageButton
                android:id="@+id/btnImport"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_import"
                android:background="@drawable/tool_button_background"
                android:contentDescription="@string/desc_import_button" />

        </LinearLayout>

        <!-- Spacer to push buttons to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Attendance Button -->
        <ImageButton
            android:id="@+id/btnAttendance"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_attendance"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/attendance_title" />

        <!-- Logout Button -->
        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_logout"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/logout" />

    </LinearLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:id="@+id/mainContentArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Whiteboard View -->
        <com.example.moodle.ui.whiteboard.WhiteboardView
            android:id="@+id/whiteboardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />

    </LinearLayout>

    <!-- Bottom Toolbar (shown only when split mode is disabled) -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:padding="6dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Drawing Tools -->
        <ImageButton
            android:id="@+id/btnPen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_pen"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_pen_tool" />

        <ImageButton
            android:id="@+id/btnEraser"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_eraser"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_eraser_tool" />

        <ImageButton
            android:id="@+id/btnText"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_text"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_text_tool" />

        <ImageButton
            android:id="@+id/btnFormula"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_formula"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_formula_tool" />

        <!-- Shape Tools Popup Button -->
        <ImageButton
            android:id="@+id/btnShapes"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_shapes"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_shapes_tool" />

        <!-- Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="4dp"
            android:background="#E0E0E0" />

        <!-- Action Tools -->
        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_undo"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_undo_button" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_redo"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_redo_button" />

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_clear"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_clear_button" />

        <!-- Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="4dp"
            android:background="#E0E0E0" />

        <!-- Mode Tools -->
        <ImageButton
            android:id="@+id/btnModeToggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_move_4d"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_mode_toggle" />

        <ImageButton
            android:id="@+id/btnPinchMode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_zoom"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_pinch_mode" />

        <!-- Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="4dp"
            android:background="#E0E0E0" />

        <!-- Color Popup Button -->
        <Button
            android:id="@+id/btnColorPicker"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="2dp"
            android:background="@drawable/color_button_background"
            android:backgroundTint="#000000"
            android:contentDescription="@string/colors" />

        <!-- Stroke Width Popup Button -->
        <ImageButton
            android:id="@+id/btnStrokeWidth"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_stroke_width"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/stroke_width" />

        <!-- Background Pattern Button -->
        <ImageButton
            android:id="@+id/btnBackground"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_background"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_background_button" />

        <!-- Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="4dp"
            android:background="#E0E0E0" />

        <!-- Pagination Controls -->
        <ImageButton
            android:id="@+id/btnPreviousPage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_previous_page" />

        <TextView
            android:id="@+id/tvPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:text="1/1"
            android:textSize="12sp"
            android:textColor="#333333"
            android:minWidth="32dp"
            android:gravity="center"
            android:layout_gravity="center_vertical" />

        <ImageButton
            android:id="@+id/btnNextPage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_arrow_forward"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_next_page" />

        <ImageButton
            android:id="@+id/btnDeletePage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_delete"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_delete_page" />

    </LinearLayout>

</android.support.constraint.ConstraintLayout>
