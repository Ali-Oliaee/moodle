<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_background"
    android:padding="8dp"
    android:elevation="8dp">

    <!-- NORMAL 2D SHAPES SECTION -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2D Shapes"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:textColor="@android:color/black" />

    <!-- Row 1: Basic Shapes -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnLinePopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_line"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_line_tool" />

        <ImageButton
            android:id="@+id/btnCirclePopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_circle"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_circle_tool" />

        <ImageButton
            android:id="@+id/btnEllipsePopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_ellipse"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_ellipse_tool" />

        <ImageButton
            android:id="@+id/btnRectanglePopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_rectangle"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_rectangle_tool" />

        <ImageButton
            android:id="@+id/btnDiamondPopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_diamond"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_diamond_tool" />

    </LinearLayout>

    <!-- Row 2: Triangles and More -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnTrianglePopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_triangle"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_triangle_tool" />

        <ImageButton
            android:id="@+id/btnRightTrianglePopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_right_triangle"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_right_triangle_tool" />

        <ImageButton
            android:id="@+id/btnIsoscelesTrianglePopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_isosceles_triangle"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_isosceles_triangle_tool" />

        <ImageButton
            android:id="@+id/btnStarPopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_star"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_star_tool" />

        <ImageButton
            android:id="@+id/btnArrowPopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_arrow"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_arrow_tool" />

    </LinearLayout>

    <!-- Row 3: Polygons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPentagonPopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_pentagon"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_pentagon_tool" />

        <ImageButton
            android:id="@+id/btnHexagonPopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_hexagon"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_hexagon_tool" />

        <ImageButton
            android:id="@+id/btnParallelogramPopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_parallelogram"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_parallelogram_tool" />

        <ImageButton
            android:id="@+id/btnTrapezoidPopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_trapezoid"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_trapezoid_tool" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <!-- 3D SHAPES SECTION -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3D Shapes"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:textColor="@android:color/black" />

    <!-- Row 4: 3D Shapes -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnCubePopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_cube"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_cube_tool" />

        <ImageButton
            android:id="@+id/btnCylinderPopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_cylinder"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_cylinder_tool" />

        <ImageButton
            android:id="@+id/btnPyramidPopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_pyramid"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_pyramid_tool" />

        <ImageButton
            android:id="@+id/btnSpherePopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_sphere"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_sphere_tool" />

        <ImageButton
            android:id="@+id/btnConePopup"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_cone"
            android:background="@drawable/tool_button_background"
            android:contentDescription="@string/desc_cone_tool" />

    </LinearLayout>

</LinearLayout>
