<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
        <shape>
            <solid android:color="#26000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Main glassy background -->
    <item>
        <shape>
            <gradient
                android:startColor="#F5FFFFFF"
                android:endColor="#EAFFFFFF"
                android:angle="135" />
            <corners android:radius="24dp" />
            <stroke 
                android:width="2dp"
                android:color="#D0D0D0" />
        </shape>
    </item>
    <!-- Inner highlight for glass effect -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <corners android:radius="22dp" />
            <stroke 
                android:width="1dp"
                android:color="#F0FFFFFF" />
        </shape>
    </item>
</layer-list>
