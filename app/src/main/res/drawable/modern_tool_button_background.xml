<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state with gradient -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:startColor="#6366F1"
                        android:endColor="#4F46E5"
                        android:angle="135"
                        android:type="linear" />
                    <stroke 
                        android:width="2dp"
                        android:color="#6366F1" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#336366F1" />
        </shape>
    </item>
    <!-- Disabled state -->
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="#0A6366F1" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A6366F1" />
        </shape>
    </item>
</selector>
